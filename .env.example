# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
# On Vercel, set the same names under Settings → Environment Variables.

PORT=3456
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# Replace <db_password> with the database user's password.
# Leave MONGODB_URI empty to store data in local JSON files (./data) instead.
# On a hosted deployment this must be set before real payments can be taken:
# without it, bookings live in a temporary folder that the next request may not see,
# so the server refuses to start a payment.
MONGODB_URI=mongodb+srv://gurujipalmistry_db_user:<db_password>@cluster0.biq6nie.mongodb.net/?retryWrites=true&w=majority&compressors=zlib
MONGODB_DB=guruji

# ---------------------------------------------------------------------------
# Admin dashboard (/admin)
# ---------------------------------------------------------------------------
# ADMIN_PIN = full access: bookings, enquiries, content, pricing, images.
# EDITOR_PIN (optional) = content only; cannot see bookings or enquiries.
# Choose long, random values. On a hosted deployment the admin area stays
# locked until ADMIN_PIN is set.
ADMIN_PIN=change-me
EDITOR_PIN=

# ---------------------------------------------------------------------------
# Payments — Cashfree Payments (PG)
# ---------------------------------------------------------------------------
# Leave these empty to keep the site in test mode (PAYMENT_MODE=simulated):
# the booking flow works end to end but no money moves.
# With both keys set, real Cashfree checkout is used automatically.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox          # sandbox | production
# CASHFREE_API_VERSION=2023-08-01   # only if Cashfree asks you to move to a newer version
# PAYMENT_MODE=cashfree       # set automatically when the keys above are present

# Public address of the site — used in the payment return link and the webhook.
SITE_URL=

# ---------------------------------------------------------------------------
# Optional: e-mail notification when a booking is paid or an enquiry arrives
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL=support@gurujipalmistry.org
NOTIFY_FROM=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
POOJA_SLOT_CAPACITY=3         # families per pooja time slot per day
RATE_LIMIT_MULTIPLIER=1       # raise behind a shared office IP

# Tip: after filling MONGODB_URI in, run `npm run db:check` to test the
# connection. It explains any failure and never prints the password.

# ---------------------------------------------------------------------------
# Guruji's case area (/guruji)
# ---------------------------------------------------------------------------
# GURUJI_PIN opens the case list, the chat, the chart and the written reading.
# It does not open the admin dashboard. ADMIN_PIN can do both.
GURUJI_PIN=

# ---------------------------------------------------------------------------
# Video and audio sessions — Jitsi
# ---------------------------------------------------------------------------
# Three ways to run the consultation room. Pick ONE.
#
# 1. Jitsi as a Service (JaaS, 8x8) — recommended. RS256, moderator tokens.
#    JITSI_APP_ID is the "AppID / tenant" from the JaaS console (vpaas-magic-cookie-…),
#    JITSI_KID is the API key id, JITSI_PRIVATE_KEY is the whole PEM private key
#    (keep the BEGIN/END lines; newlines may be written as \n).
JITSI_APP_ID=
JITSI_KID=
JITSI_PRIVATE_KEY=
#
# 2. A self-hosted Jitsi with JWT authentication (HS256):
#    set JITSI_DOMAIN, JITSI_APP_ID and JITSI_APP_SECRET.
JITSI_DOMAIN=
JITSI_APP_SECRET=
#
# 3. Nothing set — the room falls back to the public meet.jit.si service.
#    It works, but anyone with the link could walk in, so the join screen says
#    so and /api/health reports productionSafe: false. Do not use it for real
#    consultations.
#
# Optional: how long the room stays open around the appointment.
# JITSI_OPEN_BEFORE_MIN=10
# JITSI_CLOSE_AFTER_MIN=30

# ---------------------------------------------------------------------------
# Where the server listens
# ---------------------------------------------------------------------------
# Default 127.0.0.1:3456. Behind nginx on a VPS that is correct. On managed
# hosting (Hostinger's Node.js Web App, and most platforms) set HOST=0.0.0.0
# and leave PORT alone — the platform provides it.
HOST=
PORT=
